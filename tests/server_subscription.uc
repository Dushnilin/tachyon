let links = require("server.links");
let subscription = require("server.subscription");
let checks = 0;
function check(ok, message) { if (!ok) die("FAIL: " + message + "\n"); checks++; }
let token = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
let settings = { server_subscription_enabled: "1", server_subscription_token: token, server_subscription_host: "vpn.example.com" };
let vless = { ".name": "vless", label: "Сервер 1", enabled: "1", protocol: "vless", security: "none", listen_port: "1234", server_uuid: "33333333-3333-4333-8333-333333333333" };
let hy2 = { ".name": "hy2", label: "Hysteria", protocol: "hysteria2", server_password: "p@ss &?#", hysteria2_obfs_type: "", hysteria2_obfs_password: "stale" };
let mieru = { ".name": "mieru", label: "Mieru", protocol: "json_inbound", public_host: "2001:db8::1", inbound_json: '{"type":"mieru","listen_port":21017,"transport":"TCP","users":[{"name":"user name","password":"test@?#"}]}' };
let ts = { ".name": "tailscale", protocol: "tailscale" };
let disabled = { ".name": "disabled", protocol: "vless", enabled: "0", security: "none", server_uuid: "must-not-leak" };
let servers = [vless, hy2, mieru, ts, disabled];
let request = { method: "GET", path: "/" + token, query: "format=plain" };
let output = subscription.response(settings, servers, request);
check(output.code == 200, "valid subscription");
check(index(output.body, "vless://33333333-3333-4333-8333-333333333333@vpn.example.com:1234?") == 0, "VLESS host/port");
check(index(output.body, "#%D0%A1%D0%B5%D1%80%D0%B2%D0%B5%D1%80%201") >= 0, "UTF-8 labels");
check(index(output.body, "hysteria2://p%40ss%20%26%3F%23@vpn.example.com:443") >= 0, "credential URI escaping");
check(index(output.body, "stale") < 0 && index(output.body, "obfs-password") < 0, "disabled obfuscation never exported");
check(index(output.body, "mierus://user%20name:test%40%3F%23@[2001:db8::1]?port=21017&protocol=TCP&profile=Mieru") >= 0, "JSON Mieru IPv6 URI");
check(index(output.body, "must-not-leak") < 0 && index(output.body, "tailscale") < 0, "disabled/unsupported excluded");
check(length(subscription.collect(settings, servers).skipped) == 1, "unsupported servers reported to admin helper");
let plain = output.body;
request.query = "";
output = subscription.response(settings, servers, request);
check(b64dec(trim(output.body)) == plain, "default Base64 decodes to UTF-8 URI list");
request.method = "HEAD";
check(subscription.response(settings, servers, request).body == "", "HEAD does not return credentials");
request.method = "POST";
check(subscription.response(settings, servers, request).code == 405, "read-only endpoint");
request.method = "GET";
request.query = "format=json";
check(subscription.response(settings, servers, request).code == 400, "unsupported format");
request.query = "format=plain&token=ignored";
check(subscription.response(settings, servers, request).code == 400, "extra query arguments rejected");
request.query = "";
let pin_calls = 0;
let reader = (s) => { pin_calls++; return "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"; };
for (let path in ["", "/", "/" + substr(token, 0, 63), "/" + token + "/", "/" + replace(token, /0/g, "f"), "/%30" + substr(token, 1)]) {
    request.path = path;
    output = subscription.response(settings, servers, request, reader);
    check(output.code == 404 && index(output.body, "vless://") < 0, "wrong token/path denied");
}
check(pin_calls == 0, "unauthenticated requests cannot read certificates");
request.path = "/" + token;
settings.server_subscription_enabled = "0";
check(subscription.response(settings, servers, request).code == 404, "disabled endpoint");
settings.server_subscription_enabled = "1";
settings.server_subscription_token = "";
check(subscription.response(settings, servers, request).code == 404, "missing token fails closed");
settings.server_subscription_token = replace(token, /0/g, "f");
check(subscription.response(settings, servers, request).code == 404, "token rotation invalidates old URL");
settings.server_subscription_token = token;
settings.server_subscription_mode = "selected";
settings.server_subscription_servers = ["hy2"];
output = subscription.response(settings, servers, request, reader);
check(length(subscription.collect(settings, servers).links) == 1 && index(b64dec(trim(output.body)), "vless://") < 0, "explicit allowlist");
check(index(b64dec(trim(output.body)), "pinSHA256=") >= 0, "self-signed certificate pin exported");
settings.server_subscription_servers = [];
check(subscription.response(settings, servers, request).code == 422, "empty allowlist cannot expose all servers");
settings.server_subscription_servers = ["vless"];
vless.server_uuid = "updated-credential";
check(index(b64dec(trim(subscription.response(settings, servers, request).body)), "updated-credential") >= 0, "response follows current saved server state");
check(links.build({protocol:"json_inbound",inbound_json:"broken"}, "vpn.example.com", "") == "", "malformed JSON inbound ignored");
check(links.build({protocol:"vless",server_uuid:"x",security:"none",public_host:"bad.example/@evil"}, "vpn.example.com", "") == "", "invalid host rejected");
check(links.build({protocol:"vless",server_uuid:"x",security:"reality"}, "vpn.example.com", "") == "", "incomplete Reality not exported");
check(index(links.build({protocol:"mtproto",label:"MTProto 205",mtproto_secret:substr(token,0,32),mtproto_padding:"0"}, "vpn.example.com", ""), "secret=" + substr(token,0,32)) >= 0, "MTProto non-padding mode");
check(index(links.build({protocol:"mtproto",label:"MTProto 205",mtproto_secret:substr(token,0,32),mtproto_padding:"0"}, "vpn.example.com", ""), "#MTProto%20205") >= 0, "MTProto label fragment");
let wg_priv = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=";
let wg_pub = "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=";
check(index(links.build({protocol:"awg",label:"AWG 205",awg_client_private_key:wg_priv,awg_server_public_key:wg_pub}, "vpn.example.com", ""), "amneziawg://") == 0, "AWG amneziawg:// URI");
check(index(links.build({protocol:"socks",socks_auth_enabled:"false",server_password:"hidden"}, "vpn.example.com", ""), "hidden") < 0, "SOCKS no-auth does not export stale credentials");
settings.server_subscription_mode = "invalid";
check(subscription.response(settings, servers, request).code == 422, "unknown selection mode fails closed");
for (let protocol in ["vmess", "trojan", "shadowsocks", "socks", "mixed", "http", "naive", "hysteria2", "tuic", "anytls", "shadowtls", "fptn", "mtproto", "awg"]) {
    let server = { protocol, label:"Server", security:"tls", server_uuid:"uuid", server_password:"password", mtproto_secret:"0123456789abcdef0123456789abcdef", awg_client_private_key:wg_priv, awg_server_public_key:wg_pub };
    check(links.build(server, "vpn.example.com", "") != "", "supported URI: " + protocol);
}
printf("PASS: server subscription (%d checks)\n", checks);
