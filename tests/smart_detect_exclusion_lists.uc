let fs = require("fs");
let common = require("core.common");
let exclusions = require("service.smart_detect_exclusions");
let checks = 0;
function check(ok, name) { if (!ok) die("FAIL: " + name + "\n"); checks++; }
function save(name, domains) {
    return common.write_json_file(exclusions.cache_path(name), {version: 1, service: name, domains});
}
let manual = {smart_detect_exclude: ["EXAMPLE.COM.", "*.cdn.other.org"]};
check(exclusions.excluded("example.com", manual), "manual domain normalized");
check(exclusions.excluded("deep.api.example.com", manual), "all subdomain levels excluded");
check(!exclusions.excluded("notexample.com", manual), "suffix boundary respected");
check(!exclusions.excluded("example.com.evil.org", manual), "domain embedded in another name is not excluded");
check(exclusions.excluded("img.cdn.other.org", manual), "wildcard manual entry normalized");
check(!exclusions.excluded("api.other.org", manual), "sibling remains eligible");
check(exclusions.target("api.other.org", manual, "other.org") == "api.other.org", "parent expansion never swallows excluded sibling");
check(exclusions.target("api.clean.org", manual, "clean.org") == "clean.org", "unaffected parent expansion retained");
check(exclusions.target("api.clean.org", {...manual, smart_detect_expand_to_root: "0"}, "clean.org") == "api.clean.org", "expand flag off keeps hostname");
check(exclusions.target("api.example.com", manual, "example.com") == null, "excluded hostname never becomes an apply target");
check(exclusions.supported("discord") && exclusions.supported("telegram"), "service presets with domains selectable");
check(!exclusions.supported("cloudflare") && !exclusions.supported("geoip_ru"), "IP-only presets rejected");
check(exclusions.cache_path("../../other") == null, "preset name cannot escape cache directory");
check(length(exclusions.selected_lists({smart_detect_exclude_lists: ["telegram", "telegram", "discord"]})) == 2, "selected presets deduplicated");
let cfg = {smart_detect_exclude: ["manual.example"], smart_detect_exclude_lists: ["telegram"]};
check(!exclusions.state(cfg).ready, "missing selected cache pauses detection");
check(exclusions.target("api.clean.org", cfg, "clean.org") == null, "missing cache cannot publish unrelated candidates either");
check(save("telegram", ["telegram.org", "t.me"]), "persistent cache written");
check(exclusions.state(cfg).ready, "populated cache resumes detection without restart");
check(exclusions.excluded("api.telegram.org", cfg) && exclusions.excluded("manual.example", cfg), "manual and preset exclusions merged");
check(!exclusions.excluded("api.clean.org", cfg), "preset exclusions do not become a global bypass policy");
let before = fs.stat(exclusions.cache_path("telegram")).inode;
check(save("telegram", ["telegram.org", "t.me"]) && fs.stat(exclusions.cache_path("telegram")).inode == before, "unchanged cache does not rewrite flash");
check(save("telegram", ["changed.org", "t.me"]), "atomic replacement succeeds");
check(exclusions.excluded("api.changed.org", cfg) && !exclusions.excluded("telegram.org", cfg), "watchdog sees atomic replacement including equal-size updates");
check(!exclusions.excluded("api.changed.org", {}), "deselected cache no longer affects detection");
check(!exclusions.state({smart_detect_exclude_lists:["unknown"]}).ready, "unknown selected preset fails closed");
check(!exclusions.state({smart_detect_exclude_lists:["discord"]}).ready, "each selected preset needs its own cache");
let fixture = getenv("DECODE_FIXTURE");
let srs = getenv("EXCLUSION_SRS_FIXTURE");
common.write_json_file(fixture, {version: 3, rules: [{domain_suffix:[".discord.com", "DISCORD.GG", "discord.com"]}, {ip_cidr:["192.0.2.0/24"]}]});
check(exclusions.prepare_list("discord", srs), "actual prepare path decodes mixed preset");
check(exclusions.excluded("media.discord.com", {smart_detect_exclude_lists:["discord"]}), "decoded preset covers subdomains");
check(length(exclusions.collect_domains([{domain_suffix:["t.me", "telegram.org"],ip_cidr:["149.154.160.0/20"],invert:false}])) == 2, "mixed domain and IP alternatives in one rule retain domains");
check(length(exclusions.collect_domains([{domain_suffix:[".ua"]}])) == 1, "TLD suffix in real Russia inside preset accepted");
check(save("telegram", ["ua"]) && exclusions.excluded("api.example.ua", cfg) && !exclusions.excluded("ua.example.org", cfg), "TLD exclusion matches final label only");
check(exclusions.collect_domains([{domain_suffix:["ua-"]}]) == null, "malformed TLD rejected");
let previous = fs.readfile(exclusions.cache_path("discord"));
fs.writefile(fixture, "invalid json");
check(!exclusions.prepare_list("discord", srs), "bad decoder output rejected");
check(fs.readfile(exclusions.cache_path("discord")) == previous, "failed refresh retains previous good cache");
common.write_json_file(fixture, {version: 3, rules: []});
check(!exclusions.prepare_list("discord", srs), "empty fallback cannot erase exclusions");
check(fs.readfile(exclusions.cache_path("discord")) == previous, "empty refresh retains exclusions");
check(exclusions.collect_domains([{invert:true,domain_suffix:["example.com"]}]) == null, "inverted matcher never flattened");
check(exclusions.collect_domains([{domain_regex:[".*"]}]) == null, "unsupported regex is not silently omitted");
check(exclusions.collect_domains([{domain_suffix:["example.com"],port:443}]) == null, "compound matcher not widened");
check(exclusions.collect_domains([{domain_suffix:["bad/name"]}]) == null, "invalid domain invalidates snapshot");
fs.writefile(exclusions.cache_path("discord"), "broken");
check(!exclusions.state({smart_detect_exclude_lists:["discord"]}).ready, "corrupt cache cannot be interpreted as an empty exclusion list");
print(sprintf("PASS: %d Smart Detect exclusion cache/matching checks\n", checks));
