function run_spec(command, spec, user_args) {
    let module = module_path(spec[0]);
    if (!file_readable(module)) {
        warn("Error: required file '", module, "' is missing or not readable\n");
        restore_dnsmasq_failsafe_on_loader_failure(command);
        return 1;
    }

    let args = [ "ucode", "-L", LIB_DIR, module, spec[1] ];
    let count = int(spec[2] || 0);
    for (let i = 0; i < count; i++)
        push(args, user_args[i] || "");

    return normalize_status(system(command_from_args(args)));
}

function run_agent(user_args) {
    // tachyon agent <path> <method> [body_json] [bearer_token]
    // passes all 4 args directly to agent_api.uc which reads them as ARGV[0..3]
    let module = module_path("service/agent_api.uc");
    if (!file_readable(module)) {
        warn("Error: service/agent_api.uc is missing\n");
        return 1;
    }
    let args = [ "ucode", "-L", LIB_DIR, module,
        user_args[0] || "/",
        user_args[1] || "GET",
        user_args[2] || "{}",
        user_args[3] || ""
    ];
    return normalize_status(system(command_from_args(args)));
}

function main() {
    let command = ARGV[0] || "";

    // agent command gets all remaining args passed verbatim
    if (command == "agent") {
        let user_args = [];
        for (let i = 1; i < length(ARGV); i++)
            push(user_args, ARGV[i]);
        return run_agent(user_args);
    }

    let spec = command_spec(command);
    if (spec == null) {
        show_help();
        return 1;
    }

    let user_args = [];
    for (let i = 1; i < length(ARGV); i++)
        push(user_args, ARGV[i]);

    return run_spec(command, spec, user_args);
}

exit(main());
