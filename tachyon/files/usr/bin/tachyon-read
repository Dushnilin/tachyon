#!/usr/bin/ucode --

// Read-only entry point for the tachyon command surface.
//
// rpcd grants file permissions by path and never inspects arguments, so a session
// holding only the read role could run every subcommand of /usr/bin/tachyon, including
// emergency_reset and component_install_version. A binary cannot tell the roles apart: a
// trimmed LuCI session is the same uid with a smaller ACL and leaves nothing in the
// environment to detect. The split has to be in the file name, which is what this is.
//
// Standalone ucode on purpose, same as /usr/bin/tachyon: ucode resolves modules only
// with -L and a shebang cannot supply it, so the table below is a copy. tests/shell_inventory.sh
// forbids turning the main binary into a shell loader for the same reason. The copy is
// generated from /usr/bin/tachyon and tests/tachyon_acl_role_split.sh fails on drift.
//
// Run convention matches /usr/bin/tachyon: ucode -L <lib> -- <module> <fn> [args...]

let fs = require("fs");

function as_string(value) { return value == null ? "" : "" + value; }

const LIB_DIR = getenv("TACHYON_LIB") || "/usr/lib/tachyon";

// Only read commands appear here. A write command is not merely refused, it is absent,
// so there is no spec to fall back to.
