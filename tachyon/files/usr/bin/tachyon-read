function shell_quote(value) {
    return "'" + replace(as_string(value), /'/g, "'\\''") + "'";
}


function command_from_args(args) {
    let parts = [];
    for (let arg in args)
        push(parts, shell_quote(arg));
    return join(" ", parts);
}

function normalize_status(status) {
    status = int(status);
    if (status == -1) return 255;
    let signal = status & 127;
    if (signal != 0) return 128 + signal;
    return (status >> 8) & 255;
}

function module_path(path) { return LIB_DIR + "/" + as_string(path); }

let start_idx = 0;
while (start_idx < length(ARGV) && trim(as_string(ARGV[start_idx])) == "") start_idx++;
let command = as_string(ARGV[start_idx]);
let user_args = [];
for (let i = start_idx + 1; i < length(ARGV); i++) push(user_args, as_string(ARGV[i]));

if (command == "") { warn("tachyon-read: a command is required\n"); exit(1); }

let spec = commands[command];
if (spec == null) {
    warn("tachyon: '" + command + "' needs the write role\n");
    exit(1);
}

let module = module_path(spec[0]);
if (fs.stat(module) == null) { warn("Error: required file '" + module + "' is missing\n"); exit(1); }

let args = [ "ucode", "-L", LIB_DIR, "--", module, as_string(spec[1]) ];
let count = int(spec[2] || 0);
for (let i = 0; i < count; i++) push(args, user_args[i] || "");
for (let i = count; i < length(user_args); i++) push(args, user_args[i]);

exit(normalize_status(system(command_from_args(args))));
