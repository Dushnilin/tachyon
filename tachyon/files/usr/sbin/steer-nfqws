#!/bin/sh
#
# steer-nfqws — выбирает nfqws бинарник по нужному типу стратегии.
#
# Если в spec.json для этого output задан nfqws_bin — используем его.
# Если opts-файл содержит --lua-init (признак zapret2-стратегий) — используем nfqws2.
# Иначе: zapret → zapret2 → ошибка (стандартная логика).
#
set -u

QUEUE="${1:?нужен номер очереди}"
OPTS="${2:?нужен файл ключей}"
SPEC="${STEER_SPEC:-/etc/steer/spec.json}"

case "$QUEUE" in ""|*[!0-9]*) echo "steer-nfqws: номер очереди — число, а не «$QUEUE»" >&2; exit 2 ;; esac

# 1. Если NFQWS уже задан извне — доверяем вызывающему.
if [ -n "${NFQWS:-}" ]; then
    :
# 2. Смотрим в spec.json: ищем output с совпадающим opts_file и берём его nfqws_bin.
elif [ -r "$SPEC" ] && [ -r "$OPTS" ]; then
    _spec_bin="$(ucode -e "
let spec = json(fs.readfile('$SPEC'));
if (type(spec) == 'object' && type(spec.outputs) == 'object') {
    for (let _n, _o in spec.outputs) {
        if (type(_o) == 'object' && _o.opts_file == '$OPTS' && type(_o.nfqws_bin) == 'string' && _o.nfqws_bin != '') {
            print(_o.nfqws_bin);
            break;
        }
    }
}
" 2>/dev/null)"
    if [ -n "$_spec_bin" ] && [ -x "$_spec_bin" ]; then
        NFQWS="$_spec_bin"
    fi
fi

# 3. Если ещё не выбрали — определяем по содержимому opts-файла.
if [ -z "${NFQWS:-}" ]; then
    if [ -r "$OPTS" ] && grep -q -- '--lua-init' "$OPTS" 2>/dev/null; then
        # Lua-стратегии требуют nfqws2.
        NFQWS="/opt/zapret2/nfq2/nfqws2"
    elif [ -x "/opt/zapret/nfq/nfqws" ]; then
        NFQWS="/opt/zapret/nfq/nfqws"
    elif [ -x "/opt/zapret2/nfq2/nfqws2" ]; then
        NFQWS="/opt/zapret2/nfq2/nfqws2"
    else
        echo "steer-nfqws: нет ни /opt/zapret/nfq/nfqws, ни /opt/zapret2/nfq2/nfqws2" >&2
        exit 2
    fi
fi

if [ ! -x "$NFQWS" ]; then
    # Fallback: если выбранный бинарник отсутствует, пробуем противоположный.
    if [ -x "/opt/zapret2/nfq2/nfqws2" ]; then
        NFQWS="/opt/zapret2/nfq2/nfqws2"
    elif [ -x "/opt/zapret/nfq/nfqws" ]; then
        NFQWS="/opt/zapret/nfq/nfqws"
    else
        echo "steer-nfqws: нет $NFQWS — поставьте пакет zapret или zapret2" >&2
        exit 2
    fi
fi

[ -s "$OPTS" ] || {
    echo "steer-nfqws: файла стратегии $OPTS нет или он пуст" >&2
    exit 2
}

set --
while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ""|"#"*) continue ;; esac
    for word in $line; do
        set -- "$@" "$word"
    done
done < "$OPTS"

[ "$#" -gt 0 ] || { echo "steer-nfqws: в $OPTS нет ни одного ключа" >&2; exit 2; }

case "$NFQWS" in
    *nfqws2) MARK_ARG="--fwmark=0x60000000" ;;
    *)       MARK_ARG="--dpi-desync-fwmark=0x60000000" ;;
esac

exec "$NFQWS" --qnum="$QUEUE" "$MARK_ARG" --user=daemon "$@"