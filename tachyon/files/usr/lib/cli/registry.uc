#!/usr/bin/env ucode

let as_string = require("core.common").as_string;

// Single source of truth for the tachyon command surface.
//
// It was a local function inside /usr/bin/tachyon, which made it impossible to
// expose a second entry point without copying the table and hoping the copy
// stayed in sync. Both entry points require this module instead.

// Every command defaults to the write role. A command becomes readable only by
// being listed in READ_COMMANDS, so a command nobody reviewed is denied to a
// read-only session rather than opened to it.

const COMMANDS = {
