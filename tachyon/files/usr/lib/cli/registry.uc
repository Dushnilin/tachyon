function command_spec(command) {
    return COMMANDS[as_string(command)];
}

function is_read_command(command) {
    return READ_COMMANDS[as_string(command)] === true;
}

// Spec for a command the read role is allowed to run, or null. The read entry
// point must refuse on null rather than fall back to the full table.
function read_command_spec(command) {
    let name = as_string(command);
    if (!is_read_command(name))
        return null;
    return COMMANDS[name];
}

return {
    command_spec,
    is_read_command,
    read_command_spec
};
