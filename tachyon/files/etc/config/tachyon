config settings 'settings'
        option config_version '1.0.5'
        list applied_migrations 'interface_sections'
        list applied_migrations 'enable_component_checks'
        list applied_migrations 'http_connection_urls'
        list applied_migrations 'dns_hosts_to_option'
        list applied_migrations 'global_hosts_to_section'
        list applied_migrations 'orphan_section_interface_cleanup'
        list applied_migrations 'ensure_dns_server_defaults'
        option dns_type 'udp'
        list dns_server '77.88.8.8'
        list bootstrap_dns_server '77.88.8.8'
        option dns_check_interval '10s'
        option dns_recovery_check_interval '60s'
        option dns_check_timeout '2s'
        option dns_rewrite_ttl '60'
        option dns_strategy 'prefer_ipv4'
        option dns_detour_enabled '0'
        #option dns_detour_section 'main'
        list source_network_interfaces 'br-lan'
        option enable_output_network_interface '0'
        #option output_network_interface 'wan'
        option enable_badwan_interface_monitoring '0'
        #list badwan_monitored_interfaces 'wan'
        #option badwan_reload_delay '2000'
        option enable_yacd '0'
        option disable_quic '0'
        option list_update_enabled '1'
        option update_interval '1d'
        option download_all_presets '0'
        option component_update_check_enabled '1'
        option component_update_check_interval '1d'
        option component_auto_update_enabled '0'
        option component_auto_update_mode 'immediate'
        option component_auto_update_time '04:00'
        list component_auto_update_targets 'all'
        option component_backup_enabled '0'
        option latency_test_url 'https://www.gstatic.com/generate_204'
        option download_lists_via_proxy '0'
        option download_components_via_proxy '0'
        #option download_lists_via_proxy_section 'main'
        #option download_components_via_proxy_section 'main'
        option dont_touch_dhcp '0'
        option isolate_p2p '0'
        #option p2p_ports 'tcp:6881,udp:6881-6889'
        option config_path '/etc/sing-box/config.json'
        option cache_path '/tmp/sing-box/cache.db'
        option log_level 'warn'
        option exclude_ntp '0'
        option shutdown_correctly '0'
        option smart_detect '0'
        option game_console_optimizer '0'
        list game_console_ips ''
        # smart_detect: auto-detects blocked domains from logs and adds them to the first
        # section in smart_detect_sections that works via proxy.
        # list smart_detect_sections 'zapret-section'
        # list smart_detect_sections 'main-proxy'
        # Ordered: first section where the domain works via proxy wins.

        # ─── AI Watchdog settings ─────────────────────────────────────────────
        option ai_proxy_health_enabled '1'
        option ai_proxy_health_interval '30'

        # ─── Navigation & Menu settings ───────────────────────────────────────
        option default_tab 'dashboard'
        list tab_order 'dashboard'
        list tab_order 'section'
        list tab_order 'server'
        list tab_order 'profile'
        list tab_order 'schedule'
        list tab_order 'monitoring'
        list tab_order 'diagnostic'
        list tab_order 'updates'
        list tab_order 'settings'
        list tab_order 'telegram'
        option show_tab_dashboard '1'
        option show_tab_sections '1'
        option show_tab_servers '0'
        option show_tab_profiles '0'
        option show_tab_parental '0'
        option show_tab_monitoring '1'
        option show_tab_diagnostic '1'
        option show_tab_updates '1'
        option show_tab_telegram '1'
        option ai_proxy_health_fail_threshold '3'
        option ai_proxy_health_url 'https://cp.cloudflare.com/generate_204'
        option ai_dns_continuous_enabled '1'
        option ai_dns_interval '60'
        option ai_reload_dedup_enabled '1'
        option ai_metrics_enabled '1'
        option ai_metrics_retention_hours '24'
        option ai_smart_cooldowns_enabled '1'
        option ai_config_validation_enabled '1'
        option ai_graceful_degradation_enabled '1'
        option ai_telegram_status_enabled '1'
        option ai_persistent_smart_detect '1'
        option ai_adaptive_intervals_enabled '1'
        option ai_anomaly_detection_enabled '1'
        option ai_anomaly_reconnect_threshold '10'
        option enable_rag '1'
        #option warp_proxy_section ''


