#!/bin/sh /etc/rc.common
# Pure-Rust Tachyon OpenWrt procd init script (zero ucode, zero UCI)

START=99
STOP=10
USE_PROCD=1

PROG="/usr/bin/tachyon"
DATA_DIR="/etc/tachyon"

start_service() {
    [ -d /dev/net ] || mkdir -p /dev/net
    [ -c /dev/net/tun ] || mknod /dev/net/tun c 10 200 2>/dev/null || true
    modprobe nft_tproxy 2>/dev/null || true
    modprobe nft_fib_inet 2>/dev/null || true
    modprobe tun 2>/dev/null || true
    modprobe inet_diag 2>/dev/null || true
    mkdir -p "$DATA_DIR" /etc/tachyon-core /tmp/dnsmasq.d
    rm -f /var/run/tachyon/manual_stop /tmp/tachyon-rs/manual_stop 2>/dev/null || true

    procd_open_instance "tachyon"
    procd_set_param command "$PROG" daemon
    procd_set_param env TACHYON_DATA_DIR="$DATA_DIR"
    procd_set_param limits nofile="65535 65535"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    TACHYON_DATA_DIR="$DATA_DIR" "$PROG" stop-shutdown >/dev/null 2>&1 || true
}

reload_service() {
    local reason="$1"
    local status

    pidof tachyon >/dev/null 2>&1 || return 0
    trap 'exit 1' INT TERM
    if [ -n "$reason" ]; then
        TACHYON_DATA_DIR="$DATA_DIR" TACHYON_RELOAD_REASON="$reason" "$PROG" reload
    else
        TACHYON_DATA_DIR="$DATA_DIR" "$PROG" reload
    fi
    status="$?"
    trap - INT TERM
    return "$status"
}

service_triggers() {
    PROCD_RELOAD_DELAY=2000
    procd_open_trigger
    procd_add_reload_trigger "network" "firewall"
    procd_add_interface_trigger "interface.*" "wan" /etc/init.d/tachyon reload "iface_wan"
    procd_add_interface_trigger "interface.*" "wan6" /etc/init.d/tachyon reload "iface_wan6"
    procd_add_interface_trigger "interface.*" "lan" /etc/init.d/tachyon reload "iface_lan"
    procd_close_trigger
}
